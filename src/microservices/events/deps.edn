{:paths ["src" "resources"]
 :deps  {cheshire/cheshire              {:mvn/version "6.1.0"}
         compojure/compojure            {:mvn/version "1.7.2"}
         http-kit/http-kit              {:mvn/version "2.8.1"}
         metosin/malli                  {:mvn/version "0.20.0-alpha2"}
         org.clojure/clojure            {:mvn/version "1.12.0"}
         org.clojure/tools.logging      {:mvn/version "1.3.0"}
         ring/ring-defaults             {:mvn/version "0.7.0"}
         ring/ring-json                 {:mvn/version "0.5.1"}
         org.apache.kafka/kafka-clients {:mvn/version "4.1.0"}}

 :mvn/repos
 {"confluent" {:url "https://packages.confluent.io/maven/"}}

 :aliases
 {:prod  {:main-opts ["-m" "events.core"]}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.9.5"}}
          :ns-default build}}}
